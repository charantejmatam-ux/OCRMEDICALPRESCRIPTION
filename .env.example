# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# â”€â”€ Backend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CORS_ORIGINS=http://localhost:8501
MODEL_DIR=./models
# Gemma is preferred; PaddleOCR is selected by default when Gemma is unavailable.
OCR_ENGINE=gemma
# Existing local PP-OCRv6 cache paths are used by default. Set these when
# your models are stored elsewhere. Runtime weight downloads are disabled.
PADDLEOCR_DET_MODEL_PATH=
PADDLEOCR_REC_MODEL_PATH=
# Optional Gemini OCR/comparison. Requests are made only when explicitly selected in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Google AI Studio key for cloud Gemma image extraction and medicine chat.
# Prescription images and selected label/question data are sent to Google when used.
# Leave empty to use local Ollama; cloud failures fall back to local Ollama.
GEMMA_API_KEY=
GEMMA_API_MODEL=gemma-3-27b-it
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GEMMA_MODEL=gemma3:4b
GEMMA_TIMEOUT_SECONDS=600

# â”€â”€ Frontend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
BACKEND_URL=http://localhost:8000

# â”€â”€ Privacy & Storage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# By default, images are processed in-memory only and never persisted to disk.
# If Gemini or cloud Gemma is selected, prescription data is sent to Google.
# Set PERSIST_IMAGES=true only if you explicitly want to keep uploaded files in DATA_DIR.
PERSIST_IMAGES=false
DATA_DIR=./data
